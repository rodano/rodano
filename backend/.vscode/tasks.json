{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Initialize database",
			"type": "shell",
			"command": "mvn",
			"args": [
				"spring-boot:run",
				"-Dspring-boot.run.profiles=database,local",
				"-Dspring-boot.run.jvmArguments='-Drodano.init.with-data=true'"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"problemMatcher": []
		},
		{
			"label": "Start",
			"type": "shell",
			"command": "mvn",
			"args": [
				"spring-boot:run",
				"-Dspring-boot.run.jvmArguments='-Drodano.environment=DEV'"
			],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": true,
				"panel": "shared"
			},
			"problemMatcher": []
		}
	]
}
