        <chunk item-count="200" checkpoint-policy="item">
            <reader ref="ch.rodano.batch.reader.JsonPointerItemReader">
                <properties>
                    <property name="resource" value="#{jobParameters['config']}"/>
                    <property name="jsonPointer" value="/crons"/>
                    <property name="beanType" value="ch.rodano.batch.pojo.Cron"/>
                </properties>
            </reader>
            <processor ref="ch.rodano.batch.processor.ProjectIdProcessor">
                <properties>
                    <property name="projectId" value="#{jobParameters['projectId']}"/>
                </properties>
            </processor>
            <writer ref="ch.rodano.batch.writer.CronWriter">
                <properties>
                    <property name="db.url" value="#{jobParameters['db.url']}"/>
                    <property name="db.user" value="#{jobParameters['db.user']}"/>
                    <property name="db.pass" value="#{jobParameters['db.pass']}"/>
                </properties>
            </writer>
        </chunk>
    </step>

    <!-- 20) SELECTIONS -->
    <step id="selections" next="fieldBackfill">
        <listeners>
            <listener ref="ch.rodano.batch.TraceListener"/>
        </listeners>
        <chunk item-count="200" checkpoint-policy="item">
            <reader ref="ch.rodano.batch.reader.JsonPointerItemReader">
                <properties>
                    <property name="resource" value="#{jobParameters['config']}"/>
                    <property name="jsonPointer" value="/selections"/>
                    <property name="beanType" value="ch.rodano.batch.pojo.Selection"/>
                </properties>
            </reader>
            <processor ref="ch.rodano.batch.processor.ProjectIdProcessor">
                <properties>
                    <property name="projectId" value="#{jobParameters['projectId']}"/>
                </properties>
            </processor>
            <writer ref="ch.rodano.batch.writer.SelectionWriter">
                <properties>
                    <property name="db.url" value="#{jobParameters['db.url']}"/>
                    <property name="db.user" value="#{jobParameters['db.user']}"/>
                    <property name="db.pass" value="#{jobParameters['db.pass']}"/>
                </properties>
            </writer>
        </chunk>
    </step>

    <!-- 21) ADD MISSING LINKS TO FIELD MODEL -->
    <step id="fieldBackfill" next="workflowBackfill">
        <listeners>
            <listener ref="ch.rodano.batch.TraceListener"/>
        </listeners>
        <chunk item-count="100" checkpoint-policy="item">
            <reader ref="ch.rodano.batch.reader.JsonPointerItemReader">
                <properties>
                    <property name="resource" value="#{jobParameters['config']}"/>
                    <property name="jsonPointer" value="/datasetModels"/>
                    <property name="beanType" value="ch.rodano.batch.pojo.DatasetModel"/>
                </properties>
            </reader>
            <processor ref="ch.rodano.batch.processor.ProjectIdProcessor">
                <properties>
                    <property name="projectId" value="#{jobParameters['projectId']}"/>
                </properties>
            </processor>
            <writer ref="ch.rodano.batch.writer.FieldModelWriterBackfill">
                <properties>
                    <property name="db.url" value="#{jobParameters['db.url']}"/>
                    <property name="db.user" value="#{jobParameters['db.user']}"/>
                    <property name="db.pass" value="#{jobParameters['db.pass']}"/>
                </properties>
            </writer>
        </chunk>
    </step>

    <!-- 21) ADD MISSING LINKS TO WORKFLOW -->
    <step id="workflowBackfill" next="projectBackfill">
        <listeners>
            <listener ref="ch.rodano.batch.TraceListener"/>
        </listeners>
        <chunk item-count="100" checkpoint-policy="item">
            <reader ref="ch.rodano.batch.reader.JsonPointerItemReader">
                <properties>
                    <property name="resource" value="#{jobParameters['config']}"/>
                    <property name="jsonPointer" value="/workflows"/>
                    <property name="beanType" value="ch.rodano.batch.pojo.Workflow"/>
                </properties>
            </reader>
            <processor ref="ch.rodano.batch.processor.ProjectIdProcessor">
                <properties>
                    <property name="projectId" value="#{jobParameters['projectId']}"/>
                </properties>
            </processor>
            <writer ref="ch.rodano.batch.writer.WorkflowWriterBackfill">
                <properties>
                    <property name="db.url" value="#{jobParameters['db.url']}"/>
                    <property name="db.user" value="#{jobParameters['db.user']}"/>
                    <property name="db.pass" value="#{jobParameters['db.pass']}"/>
                </properties>
            </writer>
        </chunk>
    </step>

    <!-- 23) ADD MISSING PROFILE ID TO PROJECT MODEL -->
    <step id="projectBackfill">
        <listeners>
            <listener ref="ch.rodano.batch.TraceListener"/>
        </listeners>
        <chunk item-count="100" checkpoint-policy="item">
            <reader ref="ch.rodano.batch.reader.JsonPointerItemReader">
                <properties>
                    <property name="resource" value="#{jobParameters['config']}"/>
                    <property name="beanType" value="ch.rodano.batch.pojo.Project"/>
                </properties>
            </reader>
            <processor ref="ch.rodano.batch.processor.ProjectIdProcessor">
                <properties>
                    <property name="projectId" value="#{jobParameters['projectId']}"/>
                </properties>
            </processor>
            <writer ref="ch.rodano.batch.writer.ProjectWriterBackfill">
                <properties>
                    <property name="db.url" value="#{jobParameters['db.url']}"/>
                    <property name="db.user" value="#{jobParameters['db.user']}"/>
                    <property name="db.pass" value="#{jobParameters['db.pass']}"/>
                </properties>
            </writer>
        </chunk>
    </step>
</job>
